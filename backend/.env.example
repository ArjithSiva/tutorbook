# Copy this file to .env and fill in your real values. Never commit .env itself.

# MongoDB Atlas connection string (get this from your Atlas cluster's "Connect" button)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tutorbook

# Any long random string - used to sign login tokens
JWT_SECRET=replace_this_with_a_long_random_string

# Port the server runs on locally
PORT=5000

# Your deployed frontend URL (used for CORS). For local dev, this is fine as-is.
CLIENT_URL=http://localhost:5173
